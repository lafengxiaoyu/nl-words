# Supabase 配置
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_anon_key

# LemonSqueezy 配置
# 获取方式:
# 1. 登录 https://store.lemonsqueezy.com
# 2. 进入 Settings -> General
# 3. 复制 Store ID
VITE_LEMONSQUEEZY_STORE_ID=your_store_id

# 获取方式:
# 1. 在 LemonSqueezy Dashboard 创建产品
# 2. 创建 Variant (例如: Premium Monthly/Yearly)
# 3. 复制 Variant ID
VITE_LEMONSQUEEZY_PREMIUM_VARIANT_ID=your_premium_variant_id

# 可选: 月付 Variant ID (如果需要分别处理月付和年付)
VITE_LEMONSQUEEZY_MONTHLY_VARIANT_ID=your_monthly_variant_id

# 可选: 年付 Variant ID
VITE_LEMONSQUEEZY_YEARLY_VARIANT_ID=your_yearly_variant_id
